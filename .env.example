# Research Verification Workbench configuration.
# Copy to .env and fill in. .env is ignored by git; never commit real values.
# `npm start` / `npm run migrate` read .env automatically; docker compose reads it too.

# --- Model provider (required) ---------------------------------------------------------------
# openai: the app calls the OpenAI API directly with your key. Every extraction, discovery,
#         verification and revision call is billed to your OpenAI account.
# n8n:    the app calls your own n8n webhooks instead (optional; see extras/n8n/README.md).
ORCHESTRATION_MODE=openai
# Create a key at https://platform.openai.com/api-keys. The server refuses to start without it
# in openai mode.
OPENAI_API_KEY=
# Default model for drafting, classification and any role not overridden below.
OPENAI_MODEL=gpt-5.4
# Optional per-role overrides (default to OPENAI_MODEL; discovery defaults to gpt-5.4-mini).
CLAIM_EXTRACTION_MODEL=
VERIFICATION_MODEL=
REVISION_MODEL=
DISCOVERY_MODEL=gpt-5.4-mini
# Parallel verification requests per run (1-8).
VERIFICATION_CONCURRENCY=3

# --- n8n mode only (leave empty in openai mode) ------------------------------------------------
N8N_DRAFT_WEBHOOK_URL=
N8N_DISCOVERY_WEBHOOK_URL=
# Full Authorization header value your n8n webhooks expect, for example "Bearer <random value>".
N8N_WEBHOOK_AUTH_HEADER=

# --- Database --------------------------------------------------------------------------------
# docker compose: only POSTGRES_PASSWORD is needed (the bundled database is configured for you).
# Use a long random value, for example from: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=
# Without Docker: point at your own PostgreSQL 16 database, either as one URL ...
DATABASE_URL=
# ... or as separate libpq settings (used only when DATABASE_URL is empty).
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=research_workbench
PGUSER=
PGPASSWORD=

# --- Web server ------------------------------------------------------------------------------
# Loopback only. The workbench has no login; the server refuses a non-loopback HOST unless
# ALLOW_NONLOOPBACK_BIND=1 (set automatically inside the container, whose port compose
# publishes on 127.0.0.1 only).
HOST=127.0.0.1
PORT=3080
ALLOW_NONLOOPBACK_BIND=
# Host port used by docker compose (default 3080).
WORKBENCH_PORT=3080

# --- Access control and discovery hardening -----------------------------------------------------
# Optional access token (16+ characters). When set, every /api/ route requires it; the web page asks once.
# Recommended on shared machines. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORKBENCH_TOKEN=
# Extra hosts (comma separated, subdomains included) allowed to keep query strings in model-discovered URLs.
# Built in: .gov, .mil, gov.uk, europa.eu, epo.org, wipo.int, courtlistener.com, law.cornell.edu, arxiv.org, doi.org.
DISCOVERY_TRUSTED_HOSTS=
# 1 = never fetch model-discovered URLs automatically; record them for review (disposition HUMAN_REVIEW).
DISCOVERY_REQUIRE_ACCEPTANCE=

# --- Storage ---------------------------------------------------------------------------------
# Folder for acquired sources and generated reports. Default: ./storage in the install folder.
WORKBENCH_DATA_DIR=
# Optional separate locations (override WORKBENCH_DATA_DIR).
SOURCE_STORAGE_ROOT=
PROJECT_STORAGE_ROOT=

# --- Document runtime (DOCX/PDF import, DOCX/PDF/XLSX export) ----------------------------------
# Python with python-docx, reportlab, pypdf and XlsxWriter (see README). Ignored under docker compose, which
# always uses the runtime inside the image. Without Docker, remove the # and give the interpreter's full path.
# ARTIFACT_PYTHON=

# --- AI usage limits -------------------------------------------------------------------------
# Admission limits enforced by the app before each model call. They bound volume, not dollars:
# also set a monthly budget in your OpenAI account.
AI_DAILY_CALL_LIMIT=500
AI_DAILY_INPUT_BYTES=33554432
AI_JOB_CALL_LIMIT=400
AI_JOB_TIMEOUT_MS=1800000
AI_DISCOVERY_TIMEOUT_MS=2700000
# New mutations are refused when either storage location has less free space than this.
MIN_FREE_STORAGE_BYTES=536870912

# --- Optional Source Corpus / Get Files integration ----------------------------------------------
# A separately installed Get Files service (its own default address is http://127.0.0.1:8766).
# Leave all empty to disable. GET_FILES_URL / GET_FILES_TOKEN / GET_FILES_TOKEN_FILE are accepted
# as aliases for the three SOURCE_CORPUS_* settings below.
# From inside Docker, a service on your computer is http://host.docker.internal:<port>.
# Plain HTTP is accepted only for local addresses; anything else must be HTTPS.
SOURCE_CORPUS_URL=
# Bearer token for that service, given directly or as a path to a file containing it.
SOURCE_CORPUS_TOKEN=
SOURCE_CORPUS_TOKEN_FILE=
# Workbench address used by `node scripts/corpus.mjs export-project` (default http://127.0.0.1:PORT).
WORKBENCH_URL=
