{
  "name": "research-verification-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Adversarial verification of written research: claim extraction, source discovery, passage-level verification, revision and reports.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "delete-project": "node --env-file-if-exists=.env scripts/delete-project.js",
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "npm test && node --check src/server.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
